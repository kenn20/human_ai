HOST=127.0.0.1
PORT=8787
# Optional for local development. Set this in production.
EMPATHY_API_TOKEN=
# Required: Postgres for encrypted durable rewrite runs (our infra only).
DATABASE_URL=postgres://localhost:5432/emapthyai
# Required: 32-byte key as base64 or 64-char hex. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMPATHY_RUN_ENCRYPTION_KEY=
# Production uses the measured cost/quality winner. The key stays server-side.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
CLAUDE_CODE_MODEL=sonnet
# Optional web search, translation, and ElevenLabs voice-cloning providers; keys remain server-side.
EXA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# Live calls: create a Conversational AI agent and connect a Twilio number in ElevenLabs.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
TWILIO_AUTH_TOKEN=
# Set this to the exact public HTTPS URL configured in Twilio (required behind Vercel/proxies).
TWILIO_WEBHOOK_URL=https://your-domain.example/v1/telephony/twilio/incoming
# Required only for server-initiated outbound calls; never expose this to clients.
TELEPHONY_OUTBOUND_TOKEN=
# Rewrite eval providers. Create separate low-limit keys for testing.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated origins. Chrome extension origins are accepted in development.
ALLOWED_ORIGINS=http://localhost:3000,https://app.slack.com
# Optional installer telemetry. The project token is public and only permits event ingestion.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Optional, Vercel deploys only: required on api/cron/maintain.js's Authorization
ACCOUNT_OIDC_ISSUER=
ACCOUNT_OIDC_AUDIENCE=
ACCOUNT_OIDC_JWKS_URL=
# header when set. Vercel sends this automatically for its own cron invocations.
CRON_SECRET=

# --- X human-reply queue (dormant until every value below is set) ---
# Read-only X credentials. Never issue a write scope for this application.
X_READ_BEARER_TOKEN=
X_ACCOUNT_USER_ID=
# Optional: if set, the campaign refuses to run when it lists any write scope.
X_API_SCOPES=tweet.read users.read
# Google sign-in for the operator portal at /portal.
GOOGLE_OAUTH_CLIENT_ID=
SOCIAL_PORTAL_ALLOWED_EMAILS=
# Optional: overrides the default campaign attribution ID.
SOCIAL_CAMPAIGN_ID=creator_rewrites
# Optional: model for the canonical category classifier (defaults to OPENAI_MODEL).
SOCIAL_CLASSIFIER_MODEL=
# Optional: Slack incoming webhook for queue and pause alerts.
SLACK_WEBHOOK_URL=
